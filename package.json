{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.io",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate-api": "node scripts/generate-api.mjs",
    "predeploy": "npm run build && node -e \"import('node:fs').then(fs => fs.copyFileSync('dist/index.html', 'dist/404.html'))\"",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "axios": "^1.21.1",
    "bootstrap": "^5.3.8",
    "gh-pages": "^6.3.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "sharp": "^0.34.1",
    "swagger-typescript-api": "^13.15.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-mkcert": "^1.17.8",
    "vite-plugin-pwa": "^1.0.3"
  }
}
